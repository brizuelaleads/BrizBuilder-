# The bootstrap administrator. This email is granted agency-owner access so
# the first person can sign in and invite everyone else.
MAIN_ADMIN_EMAIL=admin@example.com
MAIN_ADMIN_NAME=Main Administrator
# LOCAL_DEV_ADMIN_PASSWORD / LOCAL_DEV_SESSION_TOKEN were removed. That login
# shared one password across everyone and its cookie carried the server secret
# itself, so it could not be revoked per person. Sign-in is now email +
# password per user; delete those two Cloudflare secrets.

# Worker integration-test authentication only. Do not set these on production.
BRIZBUILDER_TEST_AUTH_ENABLED=false
BRIZBUILDER_TEST_AUTH_SECRET=
BRIZBUILDER_TEST_AUTH_HOST=127.0.0.1

# Cloudflare deploy:
# Leave these blank to deploy the public website without a D1 binding.
# Set them after creating a real Cloudflare D1 database to enable the protected dashboard database.
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=brizbuilder-d1

# Supabase backend:
# Copy these from Supabase Project Settings > API.
# Never commit the real service-role key to GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase projects may call these "publishable" and "secret" keys.
# The app supports these aliases too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_LEAD_CAPTURE_BASE_URL=https://brizbuilder-leads.brizuelaleads.workers.dev
SUPABASE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_DATABASE_URL=
BRIZBUILDER_BACKEND=d1

# Transactional account/security email only. Do not use these for marketing.
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=BrizBuilder <no-reply@brizbuilder.com>
APP_BASE_URL=https://brizbuilder.com

# White-label PWA host routing. Comma-separated root domains under which a
# tenant subdomain resolves to that tenant's branding, e.g. a client with the
# subdomain "acme" is served at acme.brizbuilder.com.
#
# Leave blank to disable host-based routing entirely: the app then resolves a
# tenant from the signed-in session instead, which is what the shared app host
# does anyway. Do NOT list the workers.dev domain -- the first label there is
# the worker name, not a tenant.
#
# Requires a wildcard DNS record and a wildcard TLS certificate for each root.
BRIZBUILDER_TENANT_ROOT_DOMAINS=

# Web Push (VAPID). Generate once with:
#   node scripts/generate-vapid-keys.mjs
#
# Leave blank to disable push entirely: the opt-in control hides itself and
# every dispatch becomes a no-op, so nothing else breaks.
#
# Rotating the public key invalidates every existing device subscription, so
# treat these as long-lived. The private key is a secret: put it in .env.local
# for development and in the Sites environment settings for production, the
# same place SUPABASE_SERVICE_ROLE_KEY lives. Never commit it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: contact; push services reject a bare address.
VAPID_SUBJECT=mailto:alerts@brizbuilder.com

# Public HTTPS origin used by the remote AI connector and its OAuth metadata.
# This connector does not use OPENAI_API_KEY or any other paid model API key.
BRIZBUILDER_PUBLIC_ORIGIN=https://brizbuilder.brizuelaleads.workers.dev
# Public machine-only gateway. The dashboard and consent screen remain on the
# protected origin above.
BRIZBUILDER_AI_CONNECTOR_ORIGIN=https://brizbuilder-ai.brizuelaleads.workers.dev

# Phone system. Keep the Auth Token secret in Cloudflare; never expose it in the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WEBHOOK_BASE_URL=https://brizbuilder-leads.brizuelaleads.workers.dev
# Paste the authorization URL from Twilio Console > Settings > Connect applications.
TWILIO_CONNECT_AUTHORIZE_URL=
TWILIO_CONNECT_APP_SID=

# Google Business Profile OAuth. Keep the client secret and encryption key only
# in Cloudflare secrets. The encryption key must decode to exactly 32 bytes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://brizbuilder.com/api/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_SECRET=

# Stripe Connect (Standard). Customers connect their own Stripe account;
# BrizBuilder never stores a customer's Stripe secret key or card data.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_REDIRECT_URI=https://brizbuilder.com/api/integrations/stripe/callback
# Connect webhook endpoint:
# https://brizbuilder-leads.brizuelaleads.workers.dev/api/integrations/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Every embedded financial capability is server-authoritative and defaults off.
# Turn these on deliberately after the Stripe test-mode flow passes.
STRIPE_EMBEDDED_ENABLED=false
STRIPE_EMBEDDED_PAYMENTS_READ_ENABLED=false
STRIPE_EMBEDDED_PAYOUTS_READ_ENABLED=false
STRIPE_EMBEDDED_ONBOARDING_ENABLED=false
STRIPE_EMBEDDED_ACCOUNT_MANAGEMENT_ENABLED=false
STRIPE_EMBEDDED_REFUNDS_ENABLED=false
STRIPE_EMBEDDED_DISPUTES_ENABLED=false
STRIPE_EMBEDDED_PAYOUTS_ENABLED=false
# Keep false while using test keys. Enabling live mode requires a separate
# production review because real money and real customer data are involved.
STRIPE_EMBEDDED_LIVE_MODE_ENABLED=false

# Meta Conversions API. Each client connects their own dataset (pixel) id and
# access token from their own Events Manager; this key only encrypts those
# tokens at rest. Generate 32 random bytes as hex. Rotating it makes existing
# saved tokens undecryptable, so every client would have to reconnect.
META_TOKEN_ENCRYPTION_KEY=

# CallRail. Each client connects their own CallRail account id and API key,
# generated by a dedicated CallRail service user scoped to that one company;
# this key only encrypts those API keys at rest. Generate 32 random bytes as
# hex. Rotating it makes existing saved keys undecryptable, so every client
# would have to reconnect.
CALLRAIL_CREDENTIAL_ENCRYPTION_KEY=
# Public CallRail webhook ingress. Keep this on brizbuilder-leads; the main
# dashboard Worker remains protected by Cloudflare Access.
CALLRAIL_WEBHOOK_BASE_URL=https://brizbuilder-leads.brizuelaleads.workers.dev

# Reserved for later phases. OPENAI_API_KEY is intentionally not required by
# the AI Connector; customers use their own compatible AI account and plan.
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
